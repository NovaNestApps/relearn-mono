// src/database/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String    // bcrypt hash
  name         String?
  spacedRepetitionEnabled Boolean @default(true)
  notificationEnabled     Boolean @default(false)
  notificationTime        String?
  refreshToken String?   @db.Text // for JWT refresh
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relations
  pages             Page[]
  summaries         Summary[]
  flashcards        Flashcard[]
  quizzes           Quiz[]
  sessions          Session[]
  flashcardReviews  FlashcardReview[]
  teachbackAttempts TeachBackAttempt[]
  pretestAttempts   PretestAttempt[]
  studySessions     StudySession[]
  concepts          Concept[]

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Page {
  id          String    @id @default(uuid())
  userId      String
  url         String    @db.Text
  title       String    @db.Text
  content     String    @db.Text
  images      Json?     // Array of image data
  metadata    Json?     // Additional metadata (favicon, description, etc)
  extractedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  summaries         Summary[]
  flashcards        Flashcard[]
  quizzes           Quiz[]
  teachbackAttempts TeachBackAttempt[]
  pretestAttempts   PretestAttempt[]
  pageConcepts      PageConcept[]

  @@index([userId, createdAt])
  @@index([url])
  @@map("pages")
}

model Summary {
  id        String   @id @default(uuid())
  userId    String
  pageId    String
  content   String   @db.Text
  type      String   @default("default") // 'default', 'brief', 'detailed'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([pageId])
  @@map("summaries")
}

model Flashcard {
  id        String   @id @default(uuid())
  userId    String
  pageId    String
  question  String   @db.Text
  answer    String   @db.Text
  difficulty  String   @default("medium") // 'easy', 'medium', 'hard'
  conceptTags String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  page    Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@index([userId])
  @@index([pageId])
  @@map("flashcards")
}

model Quiz {
  id        String         @id @default(uuid())
  userId    String
  pageId    String
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  page      Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  
  @@index([userId])
  @@index([pageId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  question      String   @db.Text
  options       Json     // Array of options
  correctAnswer String
  explanation   String?  @db.Text
  conceptTags   String[] @default([])
  createdAt     DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model FlashcardReview {
  id          String   @id @default(uuid())
  userId      String
  flashcardId String
  correct     Boolean
  timeTaken   Int
  confidence  Int      // 1–4: 1=again, 2=hard, 3=good, 4=easy
  reviewedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([flashcardId])
  @@map("flashcard_reviews")
}

model TeachBackAttempt {
  id          String   @id @default(uuid())
  userId      String
  pageId      String
  attemptText String   @db.Text
  gaps        Json
  score       Float
  feedback    String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId, pageId])
  @@map("teachback_attempts")
}

model PretestAttempt {
  id        String   @id @default(uuid())
  userId    String
  pageId    String?
  url       String   @db.Text
  questions Json
  answers   Json
  phase     String   // 'before' | 'after'
  score     Float?
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId, url])
  @@map("pretest_attempts")
}

model StudySession {
  id          String    @id @default(uuid())
  userId      String
  cardIds     String[]
  sessionType String    // 'interleaved' | 'blocked'
  results     Json?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("study_sessions")
}

model Concept {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRelations ConceptRelation[] @relation("SourceConcept")
  targetRelations ConceptRelation[] @relation("TargetConcept")
  pageLinks       PageConcept[]

  @@unique([userId, name])
  @@index([userId])
  @@map("concepts")
}

model ConceptRelation {
  id           String  @id @default(uuid())
  sourceId     String
  targetId     String
  relationship String  // 'related' | 'prerequisite' | 'contrasts' | 'extends'
  strength     Float

  source Concept @relation("SourceConcept", fields: [sourceId], references: [id], onDelete: Cascade)
  target Concept @relation("TargetConcept", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@map("concept_relations")
}

model PageConcept {
  pageId    String
  conceptId String

  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([pageId, conceptId])
  @@map("page_concepts")
}
